# Local-only example. Never put real values in this file or in source control.
FETCH_SELLER_SHARED_TOKEN=replace-with-a-long-random-local-token
FETCH_SELLER_AGENT_NAME=converge-fetch-seller
FETCH_SELLER_AGENT_PORT=8000
FETCH_SELLER_AGENT_SEED=replace-with-a-local-only-seed
# Optional for a local/Mana agent deployment:
# FETCH_SELLER_AGENT_ENDPOINT=https://<verified-agent-host>/submit
# FETCH_SELLER_AGENT_MAILBOX=true

# Mana/public gateway to the hosted Agentverse seller agent:
# FETCH_SELLER_AGENT_ADDRESS=agent1...
# FETCH_SELLER_GATEWAY_TOKEN=replace-with-a-gateway-secret
# FETCH_SELLER_GATEWAY_HOST=127.0.0.1
# FETCH_SELLER_GATEWAY_PORT=8787
