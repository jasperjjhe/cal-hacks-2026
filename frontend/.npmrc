# Project-wide npm install policy. CI and local installs must use npm ci.
registry=https://registry.npmjs.org/
package-lock=true
engine-strict=true
strict-peer-deps=true
audit=true
fund=false

# Do not consume a freshly published package. This is also enforced by
# scripts/check-dependencies.mjs against package-lock.json and the registry.
min-release-age=7

# Dependency lifecycle scripts are untrusted code. The repository allowlist is
# checked before installation; npm never runs scripts during npm ci.
ignore-scripts=true
