{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buyerunion.local/contracts/seller.v1.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/SellerBrief"
    },
    {
      "$ref": "#/$defs/SellerDecision"
    }
  ],
  "$defs": {
    "SellerBrief": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "request": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "currency": {
          "type": "string",
          "const": "USD"
        },
        "deliveryRegion": {
          "type": "string",
          "const": "US-CA-SAN_FRANCISCO"
        },
        "deliveryDeadline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lines": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lineId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "role": {
                "type": "string",
                "enum": [
                  "primary",
                  "related"
                ]
              },
              "category": {
                "type": "string",
                "enum": [
                  "laptop",
                  "tech_accessory",
                  "clothing",
                  "household_accessory",
                  "small_appliance"
                ]
              },
              "profile": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "id",
                  "version"
                ],
                "additionalProperties": false
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "allowedConditions": {
                "minItems": 1,
                "maxItems": 2,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "new",
                    "refurbished"
                  ]
                }
              },
              "requirements": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "fieldId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "operator": {
                      "type": "string",
                      "enum": [
                        "equals",
                        "in",
                        "min",
                        "max",
                        "containsAll"
                      ]
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 4000
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "maxItems": 100,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 4000
                          }
                        }
                      ]
                    },
                    "unit": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "strength": {
                      "type": "string",
                      "enum": [
                        "hard",
                        "soft"
                      ]
                    },
                    "weight": {
                      "anyOf": [
                        {
                          "type": "number",
                          "const": 1
                        },
                        {
                          "type": "number",
                          "const": 2
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "fieldId",
                    "operator",
                    "value",
                    "unit",
                    "strength",
                    "weight"
                  ],
                  "additionalProperties": false
                }
              },
              "useCaseSummary": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "lineId",
              "role",
              "category",
              "profile",
              "quantity",
              "allowedConditions",
              "requirements",
              "useCaseSummary"
            ],
            "additionalProperties": false
          }
        },
        "sharedTarget": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "amountCents": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "consentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "consentedAt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "amountCents",
                "consentId",
                "consentedAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "schemaVersion",
        "request",
        "currency",
        "deliveryRegion",
        "deliveryDeadline",
        "lines",
        "sharedTarget",
        "runId"
      ],
      "additionalProperties": false
    },
    "SellerDecision": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "propose"
            },
            "proposal": {
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                },
                "jobId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "candidateId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "parentOffer": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "version": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "id",
                        "version"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "policy": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "id",
                    "version"
                  ],
                  "additionalProperties": false
                },
                "lines": {
                  "minItems": 1,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "requestLineId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "listing": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "version": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "id",
                          "version"
                        ],
                        "additionalProperties": false
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "unitCents": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "requestLineId",
                      "listing",
                      "quantity",
                      "unitCents"
                    ],
                    "additionalProperties": false
                  }
                },
                "claims": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "requestLineId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 4000
                      },
                      "sourceIds": {
                        "maxItems": 40,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        }
                      }
                    },
                    "required": [
                      "id",
                      "requestLineId",
                      "text",
                      "sourceIds"
                    ],
                    "additionalProperties": false
                  }
                },
                "fitArgument": {
                  "type": "string",
                  "maxLength": 4000
                },
                "privatePriceRationale": {
                  "type": "string",
                  "maxLength": 4000
                }
              },
              "required": [
                "schemaVersion",
                "jobId",
                "candidateId",
                "parentOffer",
                "policy",
                "lines",
                "claims",
                "fitArgument",
                "privatePriceRationale"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "proposal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "hold"
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "offer": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "jobId",
            "offer"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "abstain"
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "reasonCode": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "kind",
            "jobId",
            "reasonCode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SellerProposal": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parentOffer": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "lines": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requestLineId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "listing": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "id",
                  "version"
                ],
                "additionalProperties": false
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "unitCents": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "requestLineId",
              "listing",
              "quantity",
              "unitCents"
            ],
            "additionalProperties": false
          }
        },
        "claims": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "requestLineId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "text": {
                "type": "string",
                "maxLength": 4000
              },
              "sourceIds": {
                "maxItems": 40,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "required": [
              "id",
              "requestLineId",
              "text",
              "sourceIds"
            ],
            "additionalProperties": false
          }
        },
        "fitArgument": {
          "type": "string",
          "maxLength": 4000
        },
        "privatePriceRationale": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "schemaVersion",
        "jobId",
        "candidateId",
        "parentOffer",
        "policy",
        "lines",
        "claims",
        "fitArgument",
        "privatePriceRationale"
      ],
      "additionalProperties": false
    }
  }
}
