{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buyerunion.local/contracts/seller.v1.schema.json",
  "title": "BuyerUnion seller contracts v1",
  "description": "Allowlisted seller input and strictly bounded seller-agent output. Private buyer data is intentionally absent.",
  "oneOf": [
    { "$ref": "#/$defs/SellerBrief" },
    { "$ref": "#/$defs/SellerDecision" }
  ],
  "$defs": {
    "Ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "Value": {
      "anyOf": [
        { "type": "string", "maxLength": 2000 },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "array", "maxItems": 40, "items": { "type": "string", "maxLength": 2000 } }
      ]
    },
    "Requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fieldId", "operator", "value", "unit", "strength", "weight"],
      "properties": {
        "id": { "$ref": "#/$defs/Ref/properties/id" },
        "fieldId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "operator": { "enum": ["equals", "in", "min", "max", "containsAll"] },
        "value": { "$ref": "#/$defs/Value" },
        "unit": { "type": ["string", "null"], "maxLength": 40 },
        "strength": { "enum": ["hard", "soft"] },
        "weight": { "enum": [1, 2] }
      }
    },
    "RequestLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineId", "role", "category", "profile", "quantity", "allowedConditions", "requirements", "useCaseSummary"],
      "properties": {
        "lineId": { "$ref": "#/$defs/Ref/properties/id" },
        "role": { "enum": ["primary", "related"] },
        "category": { "enum": ["laptop", "tech_accessory", "clothing", "household_accessory", "small_appliance"] },
        "profile": { "$ref": "#/$defs/Ref" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 10 },
        "allowedConditions": { "type": "array", "minItems": 1, "items": { "enum": ["new", "refurbished"] } },
        "requirements": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/Requirement" } },
        "useCaseSummary": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "SharedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amountCents", "consentId", "consentedAt"],
      "properties": {
        "amountCents": { "type": "integer", "minimum": 1 },
        "consentId": { "$ref": "#/$defs/Ref/properties/id" },
        "consentedAt": { "type": "integer", "minimum": 1 }
      }
    },
    "SellerBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "request", "runId", "currency", "deliveryRegion", "deliveryDeadline", "lines", "sharedTarget"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "request": { "$ref": "#/$defs/Ref" },
        "runId": { "$ref": "#/$defs/Ref/properties/id" },
        "currency": { "const": "USD" },
        "deliveryRegion": { "const": "US-CA-SAN_FRANCISCO" },
        "deliveryDeadline": { "type": "integer", "minimum": 1 },
        "lines": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/RequestLine" } },
        "sharedTarget": { "anyOf": [{ "$ref": "#/$defs/SharedTarget" }, { "type": "null" }] }
      }
    },
    "OfferLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestLineId", "listing", "quantity", "unitCents"],
      "properties": {
        "requestLineId": { "$ref": "#/$defs/Ref/properties/id" },
        "listing": { "$ref": "#/$defs/Ref" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 10 },
        "unitCents": { "type": "integer", "minimum": 0 }
      }
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requestLineId", "text", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/Ref/properties/id" },
        "requestLineId": { "$ref": "#/$defs/Ref/properties/id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sourceIds": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/Ref/properties/id" } }
      }
    },
    "SellerProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "jobId", "candidateId", "parentOffer", "policy", "lines", "claims", "fitArgument", "privatePriceRationale"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "jobId": { "$ref": "#/$defs/Ref/properties/id" },
        "candidateId": { "$ref": "#/$defs/Ref/properties/id" },
        "parentOffer": { "anyOf": [{ "$ref": "#/$defs/Ref" }, { "type": "null" }] },
        "policy": { "$ref": "#/$defs/Ref" },
        "lines": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/OfferLine" } },
        "claims": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/Claim" } },
        "fitArgument": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "privatePriceRationale": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "SellerDecision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "proposal"],
          "properties": { "kind": { "const": "propose" }, "proposal": { "$ref": "#/$defs/SellerProposal" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "jobId", "offer"],
          "properties": { "kind": { "const": "hold" }, "jobId": { "$ref": "#/$defs/Ref/properties/id" }, "offer": { "$ref": "#/$defs/Ref" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "jobId", "reasonCode"],
          "properties": { "kind": { "const": "abstain" }, "jobId": { "$ref": "#/$defs/Ref/properties/id" }, "reasonCode": { "type": "string", "minLength": 1, "maxLength": 100 } }
        }
      ]
    }
  }
}
